PORT=3001

# postgres://user:password@host:5432/database — see docker ps for a locally
# running chartdb-collaboration-postgres-1 container, or start your own.
DATABASE_URL=

# Comma-separated list of allowed browser Origins for the WebSocket upgrade
# (e.g. http://localhost:5173,https://app.example.com). Empty/unset allows
# every origin — fine for local dev, not for anything else. A request with
# no Origin header at all (any non-browser client) is always allowed
# regardless of this list — see isOriginAllowed's doc comment in
# src/config.ts for why.
WEBSOCKET_ORIGIN_ALLOWLIST=

# Phase 7 (docs/design/realtime-collaboration.md) — explicit opt-in.
# "azure-ad" or "public" (default when unset). "azure-ad" with either
# ENTRA_* var below missing fails the process at boot — see config.ts.
AUTH_MODE=public

# Required only when AUTH_MODE=azure-ad. Same app registration as the
# client's VITE_ENTRA_TENANT_ID / VITE_ENTRA_CLIENT_ID (see src/lib/env.ts)
# — this server derives its expected `aud` claim as `api://<client-id>`
# from ENTRA_CLIENT_ID (entra-jwt.ts), assuming the app registration's
# Application ID URI was left at that default shape.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
