# Phase 3 (docs/design/realtime-collaboration.md §10, §5.3) — no real auth
# yet, so these three are the whole config surface. ENTRA_* vars from an
# earlier, abandoned auth plan may still be sitting in a local server/.env —
# this phase's code never reads them; ignore them until a later phase
# actually adds auth.

PORT=3001

# postgres://user:password@host:5432/database — see docker ps for a locally
# running chartdb-collaboration-postgres-1 container, or start your own.
DATABASE_URL=

# Comma-separated list of allowed browser Origins for the WebSocket upgrade
# (e.g. http://localhost:5173,https://app.example.com). Empty/unset allows
# every origin — fine for local dev, not for anything else. A request with
# no Origin header at all (any non-browser client) is always allowed
# regardless of this list — see isOriginAllowed's doc comment in
# src/config.ts for why.
WEBSOCKET_ORIGIN_ALLOWLIST=
