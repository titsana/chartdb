# Storage backend: 'dexie' (default, local browser storage) or 'api' (server/ + Postgres)
VITE_STORAGE_PROVIDER=dexie
VITE_API_BASE_URL=/api

# Optional: only used when VITE_STORAGE_PROVIDER=api. Set both to require
# Azure AD sign-in; leave both unset to run the api backend with no auth.
VITE_AZURE_AD_CLIENT_ID=
VITE_AZURE_AD_TENANT_ID=
